# ==============================================================================
# LogiPredict AI — Backend Environment Configuration Template
# Copy this file to .env and adjust values for local or production deployments.
# DO NOT commit the .env file containing actual secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="LogiPredict AI API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# API Versioning
API_V1_PREFIX="/api/v1"

# Database Connection (SQLite default for local development, PostgreSQL for production)
DATABASE_URL="sqlite:///./logipredict.db"

# Security & Authentication Secrets (Generate a 32+ character random string for production)
SECRET_KEY="insecure-dev-secret-key-change-me-in-production"

# CORS Configuration (Comma-separated list of trusted frontend origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
